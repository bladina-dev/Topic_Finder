# Marketing Agent — Environment variables
# Copy this to .env and fill in your API keys

# Google Gemini API
GOOGLE_API_KEY=your-gemini-api-key-here

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Tavily Search API
TAVILY_API_KEY=your-tavily-api-key-here

# LM Studio (local models via OpenAI-compatible API)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=default

# Agent Settings
AGENT_TIMEZONE=Africa/Cairo
AGENT_SCHEDULE_HOUR=18
AGENT_SCHEDULE_MINUTE=0

# ChromaDB
CHROMADB_PATH=./brand_data/chromadb

# Telegram Bot (get token from @BotFather, chat_id from /getUpdates)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Reports
REPORTS_PATH=./reports

# Source Management
DEFAULT_SOURCES=saudi_general
SCHEDULE_TIMES=06:00,18:00

# YouTube Scanner (v0.0.3)
YOUTUBE_SCAN_ENABLED=true
YOUTUBE_MAX_PER_CHANNEL=2
YOUTUBE_SOURCES=youtube_channels
YOUTUBE_DATA_API_KEY=               # Optional, falls back to GOOGLE_API_KEY
